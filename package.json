{
	"name": "@codethread/cli-changelog",
	"version": "0.1.1",
	"description": "Recorded changelog schemas, queries and rendering for Bun CLIs",
	"homepage": "https://github.com/codethread/cli-changelog",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codethread/cli-changelog.git"
	},
	"bin": {
		"cli-changelog": "./src/cli.ts"
	},
	"workspaces": [
		".botlake"
	],
	"files": [
		"src",
		"changelog.json"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"changelog": "bun run ./src/cli.ts changelog",
		"changelog:generate": "bun run ./scripts/generate-changelog.ts",
		"fmt": "oxfmt && bun run --filter cli-changelog-lake fmt",
		"fmt:check": "oxfmt --check && bun run --filter cli-changelog-lake fmt:check",
		"lint": "oxlint --deny-warnings && bun run --filter cli-changelog-lake lint",
		"typecheck": "tsc --noEmit && bun run --filter cli-changelog-lake typecheck",
		"test": "bun test ./tests",
		"check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "^1.4.2",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"typescript": "^7.0.2",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"zod": "^4.6.5"
	},
	"overrides": {
		"@botlake/core": "0.4.0"
	},
	"packageManager": "bun@1.4.2"
}
