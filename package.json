{
	"name": "@codethread/cli-changelog",
	"version": "0.1.0",
	"private": true,
	"description": "Recorded changelog schemas, queries and rendering for Bun CLIs",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --deny-warnings",
		"typecheck": "tsc --noEmit",
		"test": "bun test ./tests",
		"check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test"
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "^1.4.2",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"typescript": "^7.0.2"
	}
}
